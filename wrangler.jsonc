{
  // 정적 자산(public/) + 동기화 API(worker.js, D1).
  "name": "gongsi-bank",
  "main": "worker.js",
  "compatibility_date": "2026-06-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "gongsi-bank-sync", "database_id": "a9fe8826-faf6-41c9-b781-ba51179312a2" }
  ]
}
